NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# Local-only defaults aligned with compose.yaml. Replace every credential for production.
# For Neon, use the pooled connection string from your Neon project and set DATABASE_SSL=true.
DATABASE_URL=postgres://taxace:taxace_local_change_me@127.0.0.1:5432/taxace_amendments
TEST_DATABASE_URL=postgres://taxace:taxace_local_change_me@127.0.0.1:5432/taxace_amendments
DATABASE_SSL=false

# Authentication mode.
# TEMPORARY CURRENT MODE: test
# Switch AUTH_MODE back to oidc when Google Cloud / Google Workspace OAuth credentials are ready.
AUTH_MODE=test
AUTH_ALLOWED_DOMAIN=taxacebsi.com
SESSION_TTL_HOURS=12

# Temporary live-build test login.
# TEST_AUTH_EMAIL must already be provisioned as an active TaxAce application user.
# TEST_AUTH_ACCESS_CODE must be supplied outside Git and should be at least 24 characters.
TEST_AUTH_EMAIL=YOUR_TEST_USER@taxacebsi.com
TEST_AUTH_ACCESS_CODE=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET

# Google Workspace OpenID Connect is preserved but temporarily inactive while AUTH_MODE=test.
AUTH_ISSUER_URL=https://accounts.google.com
AUTH_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com
AUTH_CLIENT_SECRET=CHANGE_ME
AUTH_REDIRECT_URI=http://localhost:3000/auth/callback

# Private S3-compatible object storage. These local-only credentials match compose.yaml.
STORAGE_DRIVER=s3
S3_BUCKET=taxace-amendments
S3_REGION=us-east-1
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY_ID=taxace-local
S3_SECRET_ACCESS_KEY=taxace_local_change_me
S3_FORCE_PATH_STYLE=true
STORAGE_SIGNED_URL_TTL_SECONDS=300

IMPORT_MAX_BYTES=52428800
IMPORT_MAX_ROWS=10000
IMPORT_RETENTION_DAYS=90
